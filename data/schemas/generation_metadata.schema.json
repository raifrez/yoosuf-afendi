{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation metadata (Parquet manifest)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "population_id", "synthetic", "data_classification", "demographic_reference_year", "economic_reference_year", "currency", "economic_period", "seed", "name_catalog_version", "name_catalog_sha256", "sources", "assumptions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "population_id": {"type": "string", "minLength": 1},
    "synthetic": {"const": true},
    "data_classification": {"enum": ["derived", "assumed", "demo"]},
    "demographic_reference_year": {"type": "integer", "minimum": 1900},
    "economic_reference_year": {"type": "integer", "minimum": 1900},
    "currency": {"const": "MVR"},
    "economic_period": {"const": "month"},
    "seed": {"type": "integer"},
    "name_catalog_version": {"type": "string", "minLength": 1},
    "name_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "publisher", "file", "reference_year", "data_classification", "caveats"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "reference_year": {"type": ["integer", "null"], "minimum": 1900},
          "data_classification": {"enum": ["observed", "derived", "assumed", "demo"]},
          "caveats": {"type": "string", "minLength": 1}
        }
      }
    },
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
